# === MongoDB ===
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=studenthub

# === JWT ===
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_REFRESH_SECRET_KEY=change-this-to-a-different-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Gmail SMTP (used for verification + password reset emails) ===
# Forgot Password REQUIRES this: without a real App Password the server answers "email isn't set up" instead of pretending to send.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youraccount@gmail.com
SMTP_APP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM_NAME=StudentHub

# === OpenAI (StudentHub AI + AI Study Coach) ===
# The key lives ONLY here (backend). It is never sent to the browser. Leave the placeholder to run without AI.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (leave commented to use OpenAI itself)
# OPENAI_BASE_URL=
# Seconds to wait for the AI provider before reporting a timeout (default 90)
AI_REQUEST_TIMEOUT_SECONDS=90
# Per-student AI request budget per minute (a chat message = 1, a Study Coach generation = 4)
AI_RATE_LIMIT_PER_MINUTE=20

# === App ===
FRONTEND_URL=http://localhost:5173
# Set to "production" to refuse to start with placeholder JWT secrets
ENVIRONMENT=development
APP_TIMEZONE=Asia/Kolkata

# === Default Admin (seeded automatically on first startup) ===
ADMIN_ID=ADMIN001
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Administrator

# === Login & password-reset protection ===
# "false" (default, recommended for a public site): login errors never reveal whether an email/ID exists.
# "true" (private campus use only): precise messages such as "Account not found" / "Incorrect password".
AUTH_REVEAL_ACCOUNT_EXISTS=false
# Failed logins allowed per (IP + email) per 15 minutes before a temporary block
LOGIN_MAX_FAILURES=10
# Password-reset emails allowed per address per hour, and reset-link submissions per IP per 15 minutes
RESET_REQUESTS_PER_HOUR=5
RESET_ATTEMPTS_PER_15MIN=15

# === Student Performance Analytics (Admin dashboard) ===
# Provisional pass mark (percent). The project has no institutional rule, so set yours here.
PASS_PERCENTAGE=40
